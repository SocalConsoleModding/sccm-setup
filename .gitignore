# SCCM Setup Repo — auto-generated .gitignore
# Do not edit by hand; regenerate via build/setup_manager.

# ─── ROMs ────────────────────────────────────────────────────────────────────
# Keep the Roms/ folder structure (for customer reference), exclude all
# files inside it (at any depth). `Roms/*` only matched direct children —
# the `**` glob is required for recursive matching.
/Roms/**
!/Roms/.gitkeep

# Tico ROMs and system BIOS — keep per-system folder structure, exclude files.
# The .gitkeep files preserve the empty subfolders so customers know where
# to drop their own ROMs and BIOS for each console.
/tico/roms/**
!/tico/roms/**/.gitkeep
/tico/system/**
!/tico/system/**/.gitkeep

# Loose game files anywhere
*.nsp
*.nsz
*.xci
*.xcz
# But keep system NSPs that ship with homebrew tooling (Homebrew Launcher
# applet etc.). These need to land on customer SD cards as part of CFW
# install — exclude them from Atmosphere installs and the Album-applet
# homebrew launch path stops working.
!hbl.nsp
!atmosphere/hbl.nsp
# AAA-NSPS/ holds small homebrew forwarder NSPs (DBI, hbmenu, Tico launcher
# stubs), not game ROMs — re-include the whole folder. This negation must
# come AFTER the *.nsp rule above so git keeps the files.
!/AAA-NSPS/
!/AAA-NSPS/**

# ─── Nintendo proprietary keys ───────────────────────────────────────────────
*.keys

# ─── Lockpick (DMCA'd on GitHub, keep-quiet maintainer policy) ───────────────
bootloader/payloads/Lockpick_RCM.bin
bootloader/payloads/Lockpick_RCM_Pro.bin

# ─── RetroArch BIOS ──────────────────────────────────────────────────────────
retroarch/system/

# ─── Atmosphere runtime state (not part of a fresh setup) ────────────────────
atmosphere/automatic_backups/
atmosphere/crash_reports/
atmosphere/logs/
atmosphere/erpt_reports/
atmosphere/fatal_errors/
atmosphere/fatal_reports/

# ─── Common BIOS filenames (belt and braces) ─────────────────────────────────
**/system/scph*.bin
**/system/*bios*.bin
**/system/dc_boot.bin
**/system/gba_bios.bin
**/system/disksys.rom
**/bios/**

# ─── Editor / OS cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Setup Manager's working state (tool-only, never publish) ────────────────
.sccm/
